---
const title = "DataStudio — Scientific analysis in your browser";
const description = "DataStudio lets researchers run and share scientific analyses reproducibly.";
const canonicalURL = new URL("/", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f9f7" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header>
      <a class="brand" href="/" aria-label="DataStudio home">
        <img src="/logo.svg" alt="" width="36" height="36" />
        <span>DataStudio</span>
      </a>
      <a class="contact" href="mailto:hello@datastudioapp.com">
        Contact us <span aria-hidden="true">↗</span>
      </a>
    </header>

    <main>
      <h1>Scientific analysis<br />in your browser.</h1>
      <p class="description">{description}</p>
      <div class="actions">
        <a class="launch" href="https://app.datastudioapp.com">
          Launch app
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M5 12h14m-6-6 6 6-6 6" />
          </svg>
        </a>
        <span class="status">Alpha testing</span>
      </div>
    </main>

    <footer>
      Provided by the <a href="https://www.unsw.edu.au/institutes/rna">UNSW RNA Institute</a>
    </footer>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: Inter;
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url("/inter.ttf") format("truetype");
  }

  * {
    box-sizing: border-box;
  }

  :root {
    font-family: Inter, system-ui, sans-serif;
    color: #212d49;
    background: #f8f9f7;
    font-synthesis: none;
  }

  body {
    display: flex;
    flex-direction: column;
    width: min(1040px, 100% - 3rem);
    min-height: 100svh;
    margin: auto;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:focus-visible {
    outline: 2px solid #212d49;
    outline-offset: 6px;
  }

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-block: 2rem;
    border-bottom: 1px solid #dce0e2;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.8rem;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .contact {
    font-size: 0.875rem;
  }

  .contact span {
    margin-left: 0.35rem;
  }

  .contact:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  main {
    flex: 1;
    padding-block: clamp(5rem, 12vh, 9rem);
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .description {
    max-width: 56ch;
    margin: 2rem 0 2.5rem;
    color: #4e5868;
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.7;
  }

  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .launch {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1rem 1.25rem;
    border: 1px solid #212d49;
    border-radius: 6px;
    background: #212d49;
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .launch:hover {
    background: #344361;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #586271;
    font-size: 0.8125rem;
  }

  .status::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #bd5949;
  }

  footer {
    padding-block: 2rem;
    border-top: 1px solid #dce0e2;
    color: #586271;
    font-size: 0.8125rem;
  }

  footer a {
    color: #212d49;
    text-decoration: underline;
    text-decoration-color: #c3c8cd;
    text-underline-offset: 3px;
  }

  footer a:hover {
    text-decoration-color: currentColor;
  }

  @media (max-width: 420px) {
    header {
      padding-block: 1.5rem;
    }
  }
</style>
