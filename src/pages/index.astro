---
const title = "DataStudio — Scientific analysis in your browser";
const description = "DataStudio lets researchers run and share scientific analyses reproducibly.";
const canonicalURL = new URL("/", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f9f7" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch {}
        const system = matchMedia("(prefers-color-scheme: dark)");
        const apply = (theme) => {
          document.documentElement.dataset.theme = theme;
          document.querySelector('meta[name="theme-color"]').content = theme === "dark" ? "#0f1522" : "#f8f9f7";
        };
        apply(stored ?? (system.matches ? "dark" : "light"));
        system.addEventListener("change", (event) => {
          if (!stored) apply(event.matches ? "dark" : "light");
        });
        window.toggleTheme = () => {
          stored = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
          try {
            localStorage.setItem("theme", stored);
          } catch {}
          apply(stored);
        };
      })();
    </script>
  </head>
  <body>
    <header>
      <a class="brand" href="/" aria-label="DataStudio home">
        <img class="logo-light" src="/logo.svg" alt="" width="36" height="36" />
        <img class="logo-dark" src="/logo-reversed.svg" alt="" width="36" height="36" />
        <span>DataStudio</span>
      </a>
      <div class="header-links">
        <a class="contact" href="mailto:hello@datastudioapp.com">
          Contact us <span aria-hidden="true">↗</span>
        </a>
        <button class="theme-toggle" type="button" aria-label="Toggle dark mode" onclick="toggleTheme()">
          <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z" />
          </svg>
          <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
        </button>
      </div>
    </header>

    <main>
      <h1>Scientific analysis<br />in your browser.</h1>
      <p class="description">{description}</p>
      <div class="actions">
        <a class="launch" href="https://app.datastudioapp.com">
          Launch app
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M5 12h14m-6-6 6 6-6 6" />
          </svg>
        </a>
        <span class="status">Alpha testing</span>
      </div>
    </main>

    <footer>
      Provided by the <a href="https://www.unsw.edu.au/institutes/rna">UNSW RNA Institute</a>
    </footer>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: Inter;
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url("/inter.ttf") format("truetype");
  }

  * {
    box-sizing: border-box;
  }

  :root {
    --bg: #f8f9f7;
    --text: #212d49;
    --text-muted: #4e5868;
    --text-subtle: #586271;
    --border: #dce0e2;
    --underline: #c3c8cd;
    --button-bg: #212d49;
    --button-bg-hover: #344361;
    --button-text: #fff;
    --accent: #bd5949;

    color-scheme: light;
    font-family: Inter, system-ui, sans-serif;
    color: var(--text);
    background: var(--bg);
    font-synthesis: none;
  }

  :root[data-theme="dark"] {
    --bg: #0f1522;
    --text: #e9ecf1;
    --text-muted: #aab2bf;
    --text-subtle: #8a93a3;
    --border: #253047;
    --underline: #465167;
    --button-bg: #e9ecf1;
    --button-bg-hover: #cfd5de;
    --button-text: #0f1522;
    --accent: #ef5a47;

    color-scheme: dark;
  }

  body {
    display: flex;
    flex-direction: column;
    width: min(1040px, 100% - 3rem);
    min-height: 100svh;
    margin: auto;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 6px;
  }

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-block: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.8rem;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .logo-dark,
  [data-theme="dark"] .logo-light {
    display: none;
  }

  [data-theme="dark"] .logo-dark {
    display: block;
  }

  .header-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .contact {
    font-size: 0.875rem;
  }

  .contact span {
    margin-left: 0.35rem;
  }

  .contact:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .theme-toggle:hover {
    border-color: var(--text-subtle);
  }

  .icon-sun,
  [data-theme="dark"] .icon-moon {
    display: none;
  }

  [data-theme="dark"] .icon-sun {
    display: block;
  }

  main {
    flex: 1;
    padding-block: clamp(5rem, 12vh, 9rem);
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .description {
    max-width: 56ch;
    margin: 2rem 0 2.5rem;
    color: var(--text-muted);
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.7;
  }

  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .launch {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--button-bg);
    border-radius: 6px;
    background: var(--button-bg);
    color: var(--button-text);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .launch:hover {
    background: var(--button-bg-hover);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-subtle);
    font-size: 0.8125rem;
  }

  .status::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  footer {
    padding-block: 2rem;
    border-top: 1px solid var(--border);
    color: var(--text-subtle);
    font-size: 0.8125rem;
  }

  footer a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--underline);
    text-underline-offset: 3px;
  }

  footer a:hover {
    text-decoration-color: currentColor;
  }

  @media (max-width: 420px) {
    header {
      padding-block: 1.5rem;
    }

    .brand {
      font-size: 1.5rem;
    }

    .header-links {
      gap: 0.75rem;
    }
  }
</style>
